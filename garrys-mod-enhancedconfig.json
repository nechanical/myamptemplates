l Gameplay:sports_esports:1","Description":"World friction. Changing this materially changes movement/physics.","Keywords":"friction,sv_friction","FieldName":"sv_friction","InputType":"number","ParamFieldName":"sv_friction","IncludeInCommandLine":true,"DefaultValue":"8","MinValue":"0","MaxValue":"100","EnumValues":{}},{"DisplayName":"Maximum Physics Velocity","Category":"Gameplay:sports_esports","Subcategory":"General Gameplay:sports_esports:1","Description":"Maximum ballistic entity speed per axis.","Keywords":"physics,velocity,sv_maxvelocity","FieldName":"sv_maxvelocity","InputType":"number","ParamFieldName":"sv_maxvelocity","IncludeInCommandLine":true,"DefaultValue":"3500","MinValue":"1","MaxValue":"100000","EnumValues":{}},{"DisplayName":"Footstep Sounds","Category":"Gameplay:sports_esports","Subcategory":"General Gameplay:sports_esports:1","Description":"Enable player footstep sounds.","Keywords":"footsteps,sv_footsteps","FieldName":"sv_footsteps","InputType":"checkbox","ParamFieldName":"sv_footsteps","IncludeInCommandLine":true,"DefaultValue":"1","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Voice Chat","Category":"Gameplay:sports_esports","Subcategory":"Voice:record_voice_over:2","Description":"Enable Source voice chat.","Keywords":"voice,chat,sv_voiceenable","FieldName":"sv_voiceenable","InputType":"checkbox","ParamFieldName":"sv_voiceenable","IncludeInCommandLine":true,"DefaultValue":"1","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"All Talk","Category":"Gameplay:sports_esports","Subcategory":"Voice:record_voice_over:2","Description":"Allow players to hear voice across team/spectator boundaries when supported.","Keywords":"voice,alltalk,sv_alltalk","FieldName":"sv_alltalk","InputType":"checkbox","ParamFieldName":"sv_alltalk","IncludeInCommandLine":true,"DefaultValue":"0","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Sandbox God Mode","Category":"Gameplay:sports_esports","Subcategory":"General Gameplay:sports_esports:1","Descriptio