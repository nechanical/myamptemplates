ension","Subcategory":"Client Content Delivery:cloud_download:2","Description":"One path relative to garrysmod/ per line for resource.AddFile. Prefix a line with 'single:' to use resource.AddSingleFile. Use this for FastDL/ServerDL content from non-Workshop addons.","Keywords":"fastdl,serverdl,resource.AddFile,local,content","FieldName":"LocalResourceFiles","InputType":"Textarea","ParamFieldName":"LocalResourceFiles","DefaultValue":"","EnumValues":{}},{"DisplayName":"Additional Resource Lua","Category":"Workshop & Content:extension","Subcategory":"Client Content Delivery:cloud_download:2","Description":"Optional advanced serverside Lua appended as a separate autorun file for custom resource logic.","Keywords":"resource,lua,advanced","FieldName":"AdditionalResourceLua","InputType":"Textarea","ParamFieldName":"AdditionalResourceLua","DefaultValue":"","EnumValues":{}},{"DisplayName":"Allow ServerDL Downloads","Category":"Workshop & Content:extension","Subcategory":"Client Content Delivery:cloud_download:2","Description":"Allow Source's built-in ServerDL. It is slow and Facepunch warns it can be abused; leave disabled when using WorkshopDL/FastDL only.","Keywords":"serverdl,download,sv_allowdownload","FieldName":"sv_allowdownload","InputType":"checkbox","ParamFieldName":"sv_allowdownload","IncludeInCommandLine":true,"DefaultValue":"0","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"FastDL URL","Category":"Workshop & Content:extension","Subcategory":"Client Content Delivery:cloud_download:2","Description":"Base HTTP/HTTPS URL used for FastDL. Local Resource Files still controls what clients are told to fetch.","Keywords":"fastdl,url,sv_downloadurl","FieldName":"sv_downloadurl","InputType":"url","ParamFieldName":"sv_downloadurl","IncludeInCommandLine":true,"SkipIfEmpty":true,"DefaultValue":"","Placeholder":"https://cdn.example.com/gmod","EnumValues":{}},{"DisplayName":"Counter-Strike: Source Content","Category":"Workshop & Content:extension","Subcategory":"Mounted 