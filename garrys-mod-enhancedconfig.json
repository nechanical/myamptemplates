:1","Description":"Folder/internal name used when Initial Gamemode is set to Custom.","Keywords":"custom,gamemode","FieldName":"CustomGamemode","InputType":"text","ParamFieldName":"CustomGamemode","DefaultValue":"","Placeholder":"zombiesurvival","EnumValues":{}},{"DisplayName":"Initial Map","Category":"Quick Setup:rocket_launch","Subcategory":"Core Settings:dns:1","Description":"Map loaded on startup. Workshop maps are valid when present in the configured collection.","Keywords":"map","FieldName":"map","InputType":"enum","ParamFieldName":"map","IncludeInCommandLine":true,"SkipIfEmpty":true,"DefaultValue":"gm_construct","EnumValues":{"gm_construct":"gm_construct","gm_flatgrass":"gm_flatgrass","{{CustomMap}}":"-- Custom --"}},{"DisplayName":"Custom Map","Category":"Quick Setup:rocket_launch","Subcategory":"Core Settings:dns:1","Description":"Map name without .bsp when Initial Map is Custom.","Keywords":"custom,map","FieldName":"CustomMap","InputType":"text","ParamFieldName":"CustomMap","DefaultValue":"","Placeholder":"gm_example","EnumValues":{}},{"DisplayName":"Server Location","Category":"Quick Setup:rocket_launch","Subcategory":"Core Settings:dns:1","Description":"ISO 3166-1 alpha-2 location code displayed by GMod, such as us, gb, de, or eu.","Keywords":"location,country,sv_location","FieldName":"sv_location","InputType":"text","ParamFieldName":"sv_location","IncludeInCommandLine":true,"SkipIfEmpty":true,"DefaultValue":"","Placeholder":"us","EnumValues":{}},{"DisplayName":"Server Region (Legacy)","Category":"Server:dns","Subcategory":"Rules & Visibility:visibility:3","Description":"Legacy Source server-browser region value. sv_location is the preferred human-readable location setting.","Keywords":"region,sv_region","FieldName":"sv_region","InputType":"enum","ParamFieldName":"sv_region","IncludeInCommandLine":true,"DefaultValue":"-1","EnumValues":{"-1":"No region","0":"East Coast US","1":"West Coast US","2":"South America","3":"Europe","4":"Asia","5":"Australia","6"