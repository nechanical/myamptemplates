e. 0 means unlimited.","Keywords":"network,rate,sv_maxrate","FieldName":"sv_maxrate","InputType":"number","ParamFieldName":"sv_maxrate","IncludeInCommandLine":true,"DefaultValue":"0","MinValue":"0","MaxValue":"10000000","EnumValues":{}},{"DisplayName":"Minimum Update Rate","Category":"Networking:lan","Subcategory":"Rate Limits:swap_vert:1","Description":"Minimum cl_updaterate accepted by the server.","Keywords":"network,updaterate,sv_minupdaterate","FieldName":"sv_minupdaterate","InputType":"number","ParamFieldName":"sv_minupdaterate","IncludeInCommandLine":true,"DefaultValue":"10","MinValue":"0","MaxValue":"1000","EnumValues":{}},{"DisplayName":"Maximum Update Rate","Category":"Networking:lan","Subcategory":"Rate Limits:swap_vert:1","Description":"Maximum cl_updaterate accepted by the server.","Keywords":"network,updaterate,sv_maxupdaterate","FieldName":"sv_maxupdaterate","InputType":"number","ParamFieldName":"sv_maxupdaterate","IncludeInCommandLine":true,"DefaultValue":"66","MinValue":"1","MaxValue":"1000","EnumValues":{}},{"DisplayName":"Minimum Command Rate","Category":"Networking:lan","Subcategory":"Rate Limits:swap_vert:1","Description":"Minimum cl_cmdrate accepted by the server. 0 means unlimited/no minimum.","Keywords":"network,cmdrate,sv_mincmdrate","FieldName":"sv_mincmdrate","InputType":"number","ParamFieldName":"sv_mincmdrate","IncludeInCommandLine":true,"DefaultValue":"10","MinValue":"0","MaxValue":"1000","EnumValues":{}},{"DisplayName":"Maximum Command Rate","Category":"Networking:lan","Subcategory":"Rate Limits:swap_vert:1","Description":"Maximum cl_cmdrate accepted by the server when sv_mincmdrate is above 0.","Keywords":"network,cmdrate,sv_maxcmdrate","FieldName":"sv_maxcmdrate","InputType":"number","ParamFieldName":"sv_maxcmdrate","IncludeInCommandLine":true,"DefaultValue":"66","MinValue":"1","MaxValue":"1000","EnumValues":{}},{"DisplayName":"Maximum Routable Packet","Category":"Networking:lan","Subcategory":"Rate Limits:swap_vert:1","Description":"Upper bound for client net_maxroutable.","Keywords":"network,packet,sv_maxroutable","FieldName":"sv_maxroutable","InputType":"number","ParamFieldName":"sv_maxroutable","IncludeInCommandLine":true,"DefaultValue":"1260","MinValue":"576","MaxValue":"65535","EnumValues":{}},{"DisplayName":"Maximum Userinfo Size","Category":"Networking:lan","Subcategory":"Connection & Query Protection:security:2","Description":"Maximum amount of userinfo ConVar data a client may send. Excessively high values can hurt performance.","Keywords":"network,userinfo,security","FieldName":"sv_max_userinfo","InputType":"number","ParamFieldName":"sv_max_userinfo","IncludeInCommandLine":true,"DefaultValue":"4096","MinValue":"256","MaxValue":"65536","EnumValues":{}},{"DisplayName":"Maximum Userinfo Rate","Category":"Networking:lan","Subcategory":"Connection & Query Protection:security:2","Description":"Maximum userinfo ConVar data rate per client per second.","Keywords":"network,userinfo,rate,security","FieldName":"sv_max_userinfo_rate","InputType":"number","ParamFieldName":"sv_max_userinfo_rate","IncludeInCommandLine":true,"DefaultValue":"1500","MinValue":"0","MaxValue":"100000","EnumValues":{}},{"DisplayName":"Max Voice Packets Per Frame","Category":"Networking:lan","Subcategory":"Connection & Query Protection:security:2","Description":"Voice packets accepted from one client per frame/tick before the client is kicked. 0 disables the protection.","Keywords":"voice,packet,security,sv_maxvoicepacketsperframe","FieldName":"sv_maxvoicepacketsperframe","InputType":"number","ParamFieldName":"sv_maxvoicepacketsperframe","IncludeInCommandLine":true,"DefaultValue":"48","MinValue":"0","MaxValue":"10000","EnumValues":{}},{"DisplayName":"Per-IP Queries / Second","Category":"Networking:lan","Subcategory":"Connection & Query Protection:security:2","Description":"Maximum server-browser queries per second answered from one IP.","Keywords":"query,rate,security","FieldName":"sv_max_queries_sec","InputType":"number","ParamFieldName":"sv_max_queries_sec","IncludeInCommandLine":true,"DefaultValue":"3","MinValue":"0","MaxValue":"100000","EnumValues":{}},{"DisplayName":"Global Queries / Second","Category":"Networking:lan","Subcategory":"Connection & Query Protection:security:2","Description":"Maximum server-browser queries per second answered globally.","Keywords":"query,rate,security","FieldName":"sv_max_queries_sec_global","InputType":"number","ParamFieldName":"sv_max_queries_sec_global","IncludeInCommandLine":true,"DefaultValue":"3000","MinValue":"0","MaxValue":"1000000","EnumValues":{}},{"DisplayName":"Query Averaging Window","Category":"Networking:lan","Subcategory":"Connection & Query Protection:security:2","Description":"Window used for query-rate averaging.","Keywords":"query,window,security","FieldName":"sv_max_queries_window","InputType":"number","ParamFieldName":"sv_max_queries_window","IncludeInCommandLine":true,"DefaultValue":"30","Suffix":"seconds","MinValue":"1","MaxValue":"3600","EnumValues":{}},{"DisplayName":"Per-IP Connections / Second","Category":"Networking:lan","Subcategory":"Connection & Query Protection:security:2","Description":"Maximum connection attempts per second responded to from one IP.","Keywords":"connect,rate,security","FieldName":"sv_max_connects_sec","InputType":"number","ParamFieldName":"sv_max_connects_sec","IncludeInCommandLine":true,"DefaultValue":"2","MinValue":"0","MaxValue":"100000","EnumValues":{}},{"DisplayName":"Global Connections / Second","Category":"Networking:lan","Subcategory":"Connection & Query Protection:security:2","Description":"Maximum connection attempts per second responded to globally. 0 preserves the engine default unlimited behaviour.","Keywords":"connect,rate,security","FieldName":"sv_max_connects_sec_global","InputType":"number","ParamFieldName":"sv_max_connects_sec_global","IncludeInCommandLine":true,"DefaultValue":"0","MinValue":"0","MaxValue":"1000000","EnumValues":{}},{"DisplayName":"Connection Averaging Window","Category":"Networking:lan","Subcategory":"Connection & Query Protection:security:2","Description":"Window used for connection-rate averaging.","Keywords":"connect,window,security","FieldName":"sv_max_connects_window","InputType":"number","ParamFieldName":"sv_max_connects_window","IncludeInCommandLine":true,"DefaultValue":"4","Suffix":"seconds","MinValue":"1","MaxValue":"3600","EnumValues":{}},{"DisplayName":"Server Tickrate","Category":"Performance:speed","Subcategory":"Engine Behaviour:speed:1","Description":"Optional -tickrate launch override. Engine default is approximately 66.67. Lower values reduce simulation work but can change gameplay and addon behaviour.","Keywords":"tickrate,performance","FieldName":"TickrateArg","InputType":"enum","ParamFieldName":"TickrateArg","DefaultValue":"","EnumValues":{"":"Engine default (~66.67)","-tickrate 33 ":"33","-tickrate 50 ":"50","-tickrate 66 ":"66"}},{"DisplayName":"Think While Hibernating","Category":"Performance:speed","Subcategory":"Engine Behaviour:speed:1","Description":"Force server thinking while empty/hibernating. Enabling this increases idle CPU use but may be required by some systems.","Keywords":"hibernate,think,performance","FieldName":"sv_hibernate_think","InputType":"checkbox","ParamFieldName":"sv_hibernate_think","IncludeInCommandLine":true,"DefaultValue":"0","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Drop Bots On Hibernation","Category":"Performance:speed","Subcategory":"Engine Behaviour:speed:1","Description":"Kick bots when the server enters hibernation.","Keywords":"hibernate,bots,performance","FieldName":"sv_hibernate_drop_bots","InputType":"checkbox","ParamFieldName":"sv_hibernate_drop_bots","IncludeInCommandLine":true,"DefaultValue":"1","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Low Edict Warning Threshold","Category":"Performance:speed","Subcategory":"Engine Behaviour:speed:1","Description":"Number of remaining free edicts that triggers sv_lowedict_action.","Keywords":"edict,limit,performance","FieldName":"sv_lowedict_threshold","InputType":"number","ParamFieldName":"sv_lowedict_threshold","IncludeInCommandLine":true,"DefaultValue":"8","MinValue":"1","MaxValue":"2048","EnumValues":{}},{"DisplayName":"Low Edict Action","Category":"Performance:speed","Subcategory":"Engine Behaviour:speed:1","Description":"Action taken when free edicts fall below the threshold. Conservative default logs a warning rather than forcing a restart/map change.","Keywords":"edict,limit,action","FieldName":"sv_lowedict_action","InputType":"enum","ParamFieldName":"sv_lowedict_action","IncludeInCommandLine":true,"DefaultValue":"1","EnumValues":{"0":"No action","1":"Warn/log","2":"Attempt server restart","3":"Restart current map","4":"Advance mapcycle"}},{"DisplayName":"Collect CPU Stats","Category":"Performance:speed","Subcategory":"Engine Behaviour:speed:1","Description":"Collect Source server CPU usage statistics.","Keywords":"stats,cpu,performance","FieldName":"sv_stats","InputType":"checkbox","ParamFieldName":"sv_stats","IncludeInCommandLine":true,"DefaultValue":"1","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Usercmd Replay Tick Limit","Category":"Performance:speed","Subcategory":"Engine Behaviour:speed:1","Description":"Maximum number of client-issued usercmd ticks replayed during packet loss. 0 removes the restriction.","Keywords":"usercmd,packetloss,performance,security","FieldName":"sv_maxusrcmdprocessticks","InputType":"number","ParamFieldName":"sv_maxusrcmdprocessticks","IncludeInCommandLine":true,"DefaultValue":"24","MinValue":"0","MaxValue":"1024","EnumValues":{}},{"DisplayName":"Enable Log File","Category":"Logging & SourceTV:description","Subcategory":"Server Logging:description:1","Description":"Write Source server log files.","Keywords":"log,sv_logfile","FieldName":"sv_logfile","InputType":"checkbox","ParamFieldName":"sv_logfile","IncludeInCommandLine":true,"DefaultValue":"1","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Echo Logs To Console","Category":"Logging & SourceTV:description","Subcategory":"Server Logging:description:1","Description":"Echo log messages to the server console/RCON stream.","Keywords":"log,echo,sv_logecho","FieldName":"sv_logecho","InputType":"checkbox","ParamFieldName":"sv_logecho","IncludeInCommandLine":true,"DefaultValue":"1","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Single Log File","Category":"Logging & SourceTV:description","Subcategory":"Server Logging:description:1","Description":"Write server information into one log file instead of rotating normal Source logs.","Keywords":"log,onefile,sv_log_onefile","FieldName":"sv_log_onefile","InputType":"checkbox","ParamFieldName":"sv_log_onefile","IncludeInCommandLine":true,"DefaultValue":"0","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Compress Closed Log Files","Category":"Logging & SourceTV:description","Subcategory":"Server Logging:description:1","Description":"Gzip-compress a log file when it is closed.","Keywords":"log,gzip,compress","FieldName":"sv_logfilecompress","InputType":"checkbox","ParamFieldName":"sv_logfilecompress","IncludeInCommandLine":true,"DefaultValue":"0","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Flush Log Every Write","Category":"Logging & SourceTV:description","Subcategory":"Server Logging:description:1","Description":"Flush each log write immediately. This is slower and is mainly useful for crash/debug investigations.","Keywords":"log,flush,debug","FieldName":"sv_logflush","InputType":"checkbox","ParamFieldName":"sv_logflush","IncludeInCommandLine":true,"DefaultValue":"0","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Client Lua Error Logging","Category":"Logging & SourceTV:description","Subcategory":"Server Logging:description:1","Description":"Controls handling of clientside Lua errors.","Keywords":"lua,error,log","FieldName":"sv_log_client_errors","InputType":"enum","ParamFieldName":"sv_log_client_errors","IncludeInCommandLine":true,"DefaultValue":"1","EnumValues":{"-1":"Do not print/log","0":"Console only","1":"Write clientside_errors.txt"}},{"DisplayName":"Log Bans","Category":"Logging & SourceTV:description","Subcategory":"Server Logging:description:1","Description":"Include ban activity in server logs.","Keywords":"log,bans","FieldName":"sv_logbans","InputType":"checkbox","ParamFieldName":"sv_logbans","IncludeInCommandLine":true,"DefaultValue":"0","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"Disable SourceTV","Category":"Logging & SourceTV:description","Subcategory":"SourceTV:tv:2","Description":"Disable SourceTV entirely with the -nohltv launch flag.","Keywords":"sourcetv,nohltv","FieldName":"nohltv","InputType":"checkbox","ParamFieldName":"nohltv","DefaultValue":"-nohltv ","EnumValues":{"False":"","True":"-nohltv "}},{"DisplayName":"Automatic SourceTV Demo Recording","Category":"Logging & SourceTV:description","Subcategory":"SourceTV:tv:2","Description":"Automatically record SourceTV demos.","Keywords":"sourcetv,demo,tv_autorecord","FieldName":"tv_autorecord","InputType":"checkbox","ParamFieldName":"tv_autorecord","IncludeInCommandLine":true,"DefaultValue":"0","EnumValues":{"False":"0","True":"1"}},{"DisplayName":"SourceTV Viewer Limit","Category":"Logging & SourceTV:description","Subcategory":"SourceTV:tv:2","Description":"Maximum SourceTV viewers. 0 prevents viewers but still permits local recording.","Keywords":"sourcetv,viewers,tv_maxclients","FieldName":"tv_maxclients","InputType":"number","ParamFieldName":"tv_maxclients","IncludeInCommandLine":true,"DefaultValue":"0","Suffix":"viewers","MinValue":"0","MaxValue":"255","EnumValues":{}},{"DisplayName":"SourceTV Maximum Rate","Category":"Logging & SourceTV:description","Subcategory":"SourceTV:tv:2","Description":"Maximum SourceTV spectator bandwidth rate. 0 means unlimited.","Keywords":"sourcetv,rate,tv_maxrate","FieldName":"tv_maxrate","InputType":"number","ParamFieldName":"tv_maxrate","IncludeInCommandLine":true,"DefaultValue":"8000","MinValue":"0","MaxValue":"10000000","EnumValues":{}},{"DisplayName":"Disable VAC","Category":"Advanced:tune","Subcategory":"Startup Flags:terminal:2","Description":"Start with -insecure and disable VAC. Usually leave off.","Keywords":"vac,insecure,startup","FieldName":"insecure","InputType":"checkbox","ParamFieldName":"insecure","DefaultValue":"","EnumValues":{"False":"","True":"-insecure "}},{"DisplayName":"Additional Startup Parameters","Category":"Advanced:tune","Subcategory":"Startup Flags:terminal:2","Description":"Raw startup flags inserted before AMP-managed +commands. Do not duplicate options already exposed by this template.","Keywords":"custom,startup,parameters","FieldName":"CustomParameters","InputType":"text","ParamFieldName":"CustomParameters","DefaultValue":"","Placeholder":"-condebug","EnumValues":{}},{"DisplayName":"Additional Console Variables","Category":"Advanced:tune","Subcategory":"Power User Overrides:terminal:1","Description":"Raw +commands/convars inserted after AMP-managed settings but before the final override cfg.","Keywords":"custom,convar,advanced","FieldName":"CustomConVars","InputType":"text","ParamFieldName":"CustomConVars","DefaultValue":"","Placeholder":"+developer 1","EnumValues":{}},{"DisplayName":"Additional Server Settings","Category":"Advanced:tune","Subcategory":"Power User Overrides:terminal:1","Description":"Normal custom cfg commands. AMP writes these to cfg/amp_user.cfg and executes them before AMP-managed settings, so explicit AMP fields win on conflicts.","Keywords":"server.cfg,user,settings,custom","FieldName":"UserSettings","InputType":"Textarea","ParamFieldName":"UserSettings","DefaultValue":"","EnumValues":{}},{"DisplayName":"Power User Server Settings","Category":"Advanced:tune","Subcategory":"Power User Overrides:terminal:1","Description":"Final cfg commands written to cfg/amp_override.cfg and executed after AMP-managed settings. Values here intentionally override the UI. Use with care.","Keywords":"override,power,user,advanced","FieldName":"PowerUserSettings","InputType":"Textarea","ParamFieldName":"PowerUserSettings","DefaultValue":"","EnumValues":{}},{"DisplayName":"Internal Resource Helper","Category":"Advanced:tune","Subcategory":"Power User Overrides:terminal:1","Description":"Internal helper generated by the template.","Keywords":"internal,resource,lua","FieldName":"ResourceHelperLua","InputType":"Textarea","ParamFieldName":"ResourceHelperLua","Hidden":true,"DefaultValue":"-- Managed by AMP Garry's Mod Enhanced.\n-- Do not edit this file directly; use the AMP settings that generate the two cfg lists below.\n\nlocal function eachConfiguredLine(path, callback)\n    local contents = file.Read(path, \"GAME\")\n    if not contents then return end\n\n    for line in string.gmatch(contents, \"[^\\r\\n]+\") do\n        line = string.Trim(line)\n\n        if line ~= \"\" and not string.StartWith(line, \"#\") and not string.StartWith(line, \"//\") then\n            callback(line)\n        end\n    end\nend\n\n-- One Steam Workshop FILE id per line. Collection ids are not valid here.\neachConfiguredLine(\"cfg/amp_workshop_ids.txt\", function(id)\n    if string.match(id, \"^%d+$\") then\n        resource.AddWorkshop(id)\n    else\n        ErrorNoHalt(\"[AMP] Ignoring invalid Workshop file id: \" .. tostring(id) .. \"\\n\")\n    end\nend)\n\n-- One path relative to garrysmod/ per line.\n-- Prefix a line with \"single:\" to use resource.AddSingleFile instead of resource.AddFile.\neachConfiguredLine(\"cfg/amp_resource_files.txt\", function(path)\n    if string.StartWith(path, \"single:\") then\n        resource.AddSingleFile(string.Trim(string.sub(path, 8)))\n    else\n        resource.AddFile(path)\n    end\nend)\n","EnumValues":{}},{"DisplayName":"Managed server.cfg","Category":"Advanced:tune","Subcategory":"Power User Overrides:terminal:1","Description":"Internal minimal server.cfg generated by the template.","Keywords":"internal,server.cfg","FieldName":"ManagedServerCfg","InputType":"Textarea","ParamFieldName":"ManagedServerCfg","Hidden":true,"DefaultValue":"// Managed by AMP Garry's Mod Enhanced.\n// Intentionally kept minimal so AMP-managed command-line settings remain authoritative.\n// Put normal custom cvars/commands in \"Additional Server Settings\" in AMP.\n// Put last-word overrides in \"Power User Server Settings\" in AMP.\n","EnumValues":{}},{"DisplayName":"Server Branch","Category":"Updates:download","Subcategory":"Steam Downloads:download:1","Description":"Garry's Mod dedicated-server Steam branch. Update the instance after changing this.","Keywords":"steam,branch,public,prerelease,dev","FieldName":"ServerBranch","InputType":"enum","ParamFieldName":"ServerBranch","DefaultValue":"public","EnumValues":{"public":"Public","prerelease":"Pre-release","dev":"Development"}}]